# ---- Database (shared vaugouindb; same credentials as the sibling crawlers) ----
DB_HOST=your_database_host
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAMESPACE=T_WC_

USER_TIMEZONE=Europe/Paris

# ---- TMDb (only for the collection composite poster-mix path; optional) ----
TMDB_API_DOMAIN_URL=https://api.themoviedb.org
TMDB_API_KEY=your_tmdb_api_key
TMDB_API_TOKEN=your_tmdb_jwt_api_token

# ---- Text-to-image provider (bake-off front-runner: FLUX.1 schnell on Replicate) ----
# Candidates and prices: T2I_COST in synthetic_images_functions.py (survey of 2026-10-08).
# Gemini ids (gemini-*) and OpenAI ids (gpt-image-*) call those providers directly.
REPLICATE_API_TOKEN=your_replicate_token
T2I_MODEL=black-forest-labs/flux-schnell
# Gemini image size (1K or 2K; 1K-only models are forced to 1K) and OpenAI quality (low/medium/high)
GEMINI_IMAGE_SIZE=2K
OPENAI_IMAGE_QUALITY=medium

# ---- Text-to-text (description) provider — one of the ecosystem LLM keys ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
T2T_MODEL=claude-haiku-5-5
# Effort for the description call (Claude 4.6+ / 5.x only): low keeps adaptive thinking cheap
T2T_EFFORT=low

# ---- Candidates (SYNTHETIC-IMAGES-019): one description, N renders per entity in a batch ----
CANDIDATES=3

# ---- The lab (synthetic_images_lab.py, SYNTHETIC-IMAGES-020) ----
# synthetic-images-lab.sh sets LAB_HOST=172.17.0.1 (Docker bridge only) and LAB_PORT=8195.
LAB_HOST=127.0.0.1
LAB_PORT=8195
# Daily ceiling (renders + descriptions of the day, read from the database) and renders per click
LAB_DAILY_BUDGET_USD=5
LAB_MAX_RENDERS=4
# Images preselected per click in the page (the batch uses CANDIDATES)
LAB_DEFAULT_RENDERS=1
# 1 = stub every model call (zero spend; placeholders are still written as candidates)
LAB_DRY_RUN=0

# ---- No-Wikipedia fallback web search (review §7) ----
TAVILY_API_KEY=

# ---- Logo padding (decision #7: companies/networks pad the REAL TMDb logo; zero model cost) ----
# LOGO_BASE_URL's last path segment is the TMDb size. .svg logos are fetched as the CDN's
# rasterized PNG rendition at LOGO_RASTER_SIZE (the CDN only rasterizes SVG at sized variants).
LOGO_BASE_URL=https://image.tmdb.org/t/p/original
LOGO_RASTER_SIZE=w500

# ---- Storage (review §10) ----
# Mount narrowly: `-v $HOME/docker/shared_data/synthetic-images:/shared` so the container only
# sees its OWN folder, not all of shared_data. Therefore /shared already IS the synthetic-images
# directory -> images write to /shared/<class>/. SYNTHETIC_IMAGE_SUBDIR is the URL prefix only
# (Apache serves from the real shared_data root, one level up); it is NOT a physical subdir here.
SHARED_DATA_DIR=/shared
SYNTHETIC_IMAGE_SUBDIR=synthetic-images

# ---- Pipeline tuning / provenance versions ----
STYLE_VERSION=v1
# T2T_PROMPT_VERSION is owned by the code since 2026-10-08 (v3); a value here is ignored.
T2I_PROMPT_VERSION=v1
ASPECT_RATIO=2:3
MASTER_WIDTH=1024
MASTER_HEIGHT=1536

# ---- Run guards (review §6) ----
RUN_BUDGET_USD=20
CONCURRENCY=4
USAGE_THRESHOLD=5
